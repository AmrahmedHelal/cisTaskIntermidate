using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

namespace IceCityHeatingSystem
{
    public class House
    {
        public int Id { get; set; }
        public string OwnerName { get; set; }
        public int Heaters { get; private set; }
        public double HoursPerDay { get; private set; }
        public double OutsideTemperature { get; set; }

        public House(int id, string ownerName, int heaters, double hoursPerDay, double outsideTemp)
        {
            // Input Validation
            if (string.IsNullOrWhiteSpace(ownerName))
                throw new ArgumentException("Owner name cannot be empty.");
            if (heaters < 0)
                throw new ArgumentException("Heaters cannot be negative.");
            if (hoursPerDay < 0 || hoursPerDay > 24)
                throw new ArgumentException("Hours per day must be between 0 and 24.");

            Id = id;
            OwnerName = ownerName;
            Heaters = heaters;
            HoursPerDay = hoursPerDay;
            OutsideTemperature = outsideTemp;
        }

        // Summary string for reporting
        public override string ToString()
        {
            return $"[ID: {Id}] Owner: {OwnerName} | Heaters: {Heaters} | OutsideTemp: {OutsideTemperature:F1}°C";
        }
    }

    public class CatShelter : House
    {
        public string CatName { get; set; }

        public CatShelter(int id, string ownerName, int heaters, double hoursPerDay, double outsideTemp, string catName)
            : base(id, ownerName, heaters, hoursPerDay, outsideTemp)
        {
            if (string.IsNullOrWhiteSpace(catName))
                throw new ArgumentException("Cat Name cannot be empty.");
            CatName = catName;
        }

        public override string ToString()
        {
            return base.ToString() + $" | Shelter Cat: {CatName}";
        }
    }

    public class EmptyClass
    {

    }
    public interface IHouseRepository
    {
        void Add(House house);
        IEnumerable<House> GetAll();
    }
    public class InMemoryHouseRepository : IHouseRepository
    {
        private readonly List<House> _houses = new List<House>();

        public void Add(House house)
        {
            _houses.Add(house);
        }

        public IEnumerable<House> GetAll()
        {
            return _houses;
        }
    }

   
    public delegate decimal CostCalculationStrategy(House house);

    public class CostStrategies
    {
        // Standard Calculation
        public static decimal StandardStrategy(House house)
        {
            // Base rate * heaters * hours
            return (decimal)(house.Heaters * house.HoursPerDay * 2.5);
        }

        // if temp is very low
        public static decimal StormSurgeStrategy(House house)
        {
            decimal rate = house.OutsideTemperature < -10 ? 4.0m : 2.5m;
            return (decimal)(house.Heaters * house.HoursPerDay) * rate;
        }
    }
    public class BillingService
    {
        private readonly IHouseRepository _repository;

        public BillingService(IHouseRepository repository)
        {
            _repository = repository;
        }

        public string GenerateReport(CostCalculationStrategy strategy)
        {
            var sb = new StringBuilder();
            sb.AppendLine("--- ICE CITY HEATING BILL REPORT ---");
            sb.AppendLine($"Date: {DateTime.Now}");
            sb.AppendLine("------------------------------------");

            decimal totalCityCost = 0;

            foreach (var house in _repository.GetAll())
            {

                decimal cost = strategy(house);
                totalCityCost += cost;

                sb.AppendLine($"{house.ToString()}");
                sb.AppendLine($"   => Monthly Cost: {cost:C2}");
            }

            sb.AppendLine("------------------------------------");
            sb.AppendLine($"TOTAL CITY REVENUE: {totalCityCost:C2}");
            return sb.ToString();
        }
    }

    public class TemperatureAlertEventArgs : EventArgs
    {
        public double Temperature { get; set; }
        public string SensorId { get; set; }
        public string Message { get; set; }
    }

    public class TemperatureSensorService
    {
       
        public event EventHandler<TemperatureAlertEventArgs> OnTemperatureCritical;
        private Random _rnd = new Random();

        public async Task<double> ReadSensorsAsync()
        {
            List<Task<double>> sensorTasks = new List<Task<double>>();

            // Simulate 3 sensors starting at the same time
            for (int i = 1; i <= 3; i++)
            {
                sensorTasks.Add(SimulateSingleSensorAsync($"Sensor-{i}"));
            }

            // Await all sensors to complete reading 
            double[] results = await Task.WhenAll(sensorTasks);

            return results.Average();
        }
        private async Task<double> SimulateSingleSensorAsync(string sensorId)
        {
            
            int delay = _rnd.Next(500, 3000);

            // Simulate delay taking input
            await Task.Delay(delay);

            double temp = _rnd.Next(-20, 6);

            if (temp < -10)
            {
                OnTemperatureCritical?.Invoke(this, new TemperatureAlertEventArgs
                {
                    SensorId = sensorId,
                    Temperature = temp,
                    Message = "CRITICAL FREEZE ALERT!"
                });
            }

            return temp;
        }
    
    }

    
    class Program
    {
       static async Task Main(string[] args)
       {
          Console.WriteLine("System Initializing...\n");

       
          IHouseRepository repo = new InMemoryHouseRepository();
          repo.Add(new House(1, "Omar", 3, 10, 0));
          repo.Add(new House(2, "Amr", 5, 12, 0));
          repo.Add(new CatShelter(3, "Ali", 10, 24, 0, "koko"));

          TemperatureSensorService sensorService = new TemperatureSensorService();
          BillingService billingService = new BillingService(repo);

         
          sensorService.OnTemperatureCritical += (sender, e) =>
          {
              Console.ForegroundColor = ConsoleColor.Red;
              Console.WriteLine($"!!! ALERT [{e.SensorId}]: {e.Message} ({e.Temperature}°C)");
              Console.ResetColor();
          };

          
          Console.WriteLine("Reading sensors asynchronously...");
          double avgTemp = await sensorService.ReadSensorsAsync();
          Console.WriteLine($"\nAverage Temp: {avgTemp:F1}°C");

          //Detrmine the outsidetemp based on avetemp in every house
          foreach (var h in repo.GetAll()) h.OutsideTemperature = avgTemp;

        
          var strategy = avgTemp < -5 ? (CostCalculationStrategy)CostStrategies.StormSurgeStrategy
         : CostStrategies.StandardStrategy;  

          Console.WriteLine("\n" + billingService.GenerateReport(strategy));

          Console.ReadKey();
       }
    }
}
